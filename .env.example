# Copy to .env and fill in. Never commit .env.

# Public URL of the Nelcota API. Only VITE_* variables reach the browser.
VITE_NELCOTA_URL=http://127.0.0.1:8000

# Server only: bypasses RLS. Create with `nelcota token service-role --days 30`.
NELCOTA_SERVICE_ROLE_TOKEN=

# Server only: direct Postgres connection used by `bun run test:db`.
# Locally: postgres://postgres:<POSTGRES_PASSWORD>@127.0.0.1:<DB_PORT>/postgres (see .nelcota/dev.env).
DATABASE_URL=

# Mercado Pago (developer panel > your application > credentials). Use TEST credentials first.
# Public key of the card form: safe in the browser.
VITE_MERCADO_PAGO_PUBLIC_KEY=
# Server only.
MERCADO_PAGO_ACCESS_TOKEN=
# Server only: "assinatura secreta" of the webhook, in the panel's Webhooks section.
# Webhook URL to register: <APP_URL>/api/mercado-pago/webhook (event: Pagamentos).
MERCADO_PAGO_WEBHOOK_SECRET=

# Public URL of this app. Over HTTPS it is also sent to Mercado Pago as the webhook address.
APP_URL=http://localhost:3000
