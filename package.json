{
  "name": "nelcota-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev --port 3000",
    "build": "bunx --bun vite build",
    "db:migrate": "nelcota migrate",
    "db:types": "nelcota types -o src/shared/database.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "bun test ./src",
    "test:db": "bun test ./migrations/tests",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@mercadopago/sdk-js": "0.0.3",
    "@mercadopago/sdk-react": "1.0.7",
    "@nelcota/client": "0.2.5",
    "@t3-oss/env-core": "0.13.11",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.56.0",
    "mercadopago": "3.6.1",
    "next-themes": "0.4.6",
    "papaparse": "5.7.0",
    "pix-utils": "2.8.2",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-number-format": "5.4.5",
    "recharts": "3.8.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "uqr": "0.1.3",
    "validation-br": "2.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "packageManager": "bun@1.4.4"
}
